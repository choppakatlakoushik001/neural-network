# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Virtualenvs -- this project's venv lives at ~/.venvs/neural-network-qec and
# .venv here is a SYMLINK to it (so F5 and the tmux runners find the right
# interpreter). No trailing slash on .venv: a trailing slash matches only real
# directories, which would leave the symlink itself untracked and committable.
.venv
venv/
env/

# Packaging / build
build/
dist/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Notebooks
.ipynb_checkpoints/

# Model artifacts and datasets -- keep large binaries out of git
*.pt
*.pth
*.ckpt
*.h5
*.npz
data/
checkpoints/

# Generated visualization output
/diagrams/

# Local scratch experiments
/test.py
/test_1.py

# OS / editor
.DS_Store
Thumbs.db
*.swp
